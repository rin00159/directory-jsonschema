[
	{
		"group": "基本",
		"label": "DIRDESC例: contents + json contain",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": "file",
					"description": "ディレクトリ構造説明",
					"data": {
						"schema": "json",
						"contain": {
							"$schema": "/x/package.cdx.schema.json"
						}
					},
					"name": "DIRDESC.yaml"
				}
			]
		}
	},
	{
		"group": "基本",
		"label": "struct: $schema/report/description",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"$schema": "x",
			"description": "d",
			"report": {
				"type": "report",
				"directories": 1,
				"files": 2
			}
		}
	},
	{
		"group": "基本",
		"label": "struct: 未知プロパティ",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"foo": 1
		}
	},
	{
		"group": "基本",
		"label": "struct: name は持てない(ルートは名前を持たない)",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"name": "x"
		}
	},
	{
		"group": "基本",
		"label": "struct: type は持てない",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"type": "directory"
		}
	},
	{
		"group": "基本",
		"label": "ルート配列: dir + report",
		"target": "root-array",
		"valid": true,
		"instance": [
			{
				"type": "directory",
				"name": "src",
				"contents": [
					{
						"type": "file",
						"size": 1,
						"name": "a"
					}
				]
			},
			{
				"type": "report",
				"directories": 1,
				"files": 1
			}
		]
	},
	{
		"group": "基本",
		"label": "ルート配列: name='.' (tree -J生出力) は不可",
		"target": "root-array",
		"valid": false,
		"instance": [
			{
				"type": "directory",
				"name": ".",
				"contents": []
			}
		]
	},
	{
		"group": "基本",
		"label": "未知のtype",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": "socket",
					"name": "s"
				}
			]
		}
	},
	{
		"group": "基本",
		"label": "空のノード {} は有効(条件なし)",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [{}]
		}
	},
	{
		"group": "type",
		"label": "type 省略",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"name": "a"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 配列 [directory,file]",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": ["directory", "file"],
					"name": "a"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 配列: 空は不可",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": [],
					"name": "a"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 配列: 重複は不可",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": ["file", "file"]
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 配列: 不明な種別",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": ["file", "pipe"]
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 配列[file]に contents は不可",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": ["file"],
					"contents": []
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 配列[directory,file]に contents と data は可",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": ["directory", "file"],
					"contents": [],
					"data": {
						"schema": "text",
						"const": "x"
					}
				}
			]
		}
	},
	{
		"group": "type",
		"label": "type 省略で contents / data / target すべて可",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"name": "a",
					"contents": [],
					"data": {
						"schema": "text",
						"const": "x"
					},
					"target": "t"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "file に contents は不可",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": "file",
					"contents": [],
					"name": "a"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "directory に data は不可",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": "directory",
					"data": {
						"schema": "text",
						"const": "x"
					},
					"name": "a"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "directory に target は不可",
		"target": "#/$defs/struct",
		"valid": false,
		"instance": {
			"contents": [
				{
					"type": "directory",
					"target": "t",
					"name": "a"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "link は target 無しでも可(述語)",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": "link",
					"name": "l"
				}
			]
		}
	},
	{
		"group": "type",
		"label": "link に target あり",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": "link",
					"name": "l",
					"target": "src/a"
				}
			]
		}
	},
	{
		"group": "name",
		"label": "リテラル名",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": "file",
					"name": "a.ts"
				}
			]
		}
	},
	{
		"group": "name",
		"label": "'.gitignore' は可",
		"target": "#/$defs/struct",
		"valid": true,
		"instance": {
			"contents": [
				{
					"type": "file",
