{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"allOf": [
		{
			"$ref": "https://raw.githubusercontent.com/rin00159/json-examples-validator/refs/heads/main/schema/0.0.0/json-examples-validator.json-examples.schema.json"
		}
	],
	"$defs": {
		"_hook_valid": {
			"$ref": "../../../../schema/0.0.0/directory.schema.json"
		}
	},
	"type": "object",
	"properties": {
		"jsons": {
			"type": "array",
			"items": {
				"type": "object",
				"if": {
					"properties": {
						"valid": { "const": true }
					}
				},
				"then": {
					"properties": {
						"instance": {
							"$ref": "#/$defs/_hook_valid"
						}
					}
				},
				"else": {
					"properties": {
						"instance": {
							"not": {
								"$ref": "#/$defs/_hook_valid"
							}
						}
					}
				}
			}
		}
	}
}
